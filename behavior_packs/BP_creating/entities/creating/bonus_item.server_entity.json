{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "aw:bonus_item",
            "is_experimental": false,
            "is_spawnable": false,
            "is_summonable": true,
            "properties": {
                "aw:bonus_item_type": {
                    "type": "enum",
                    "values": [
                        "sword",
                        "iron_pickaxe",
                        "gray_glazed_terracotta",
                        "wind_pearl",
                        "silver_glazed_terracotta",
                        "bow",
                        "carved_pumpkin",
                        "white_glazed_terracotta",
                        "nautilus_shell",
                        "quiver",
                        "emerald_pickaxe",
                        "water_gun"
                    ],
                    "default": "sword",
                    "client_sync": true
                },
                "aw:bonus_item_stage": { "type": "int", "range": [ 0, 3 ], "default": 0, "client_sync": true },
                "aw:bonus_item_appear_style": { "type": "int", "range": [ 0, 1 ], "default": 0, "client_sync": true }
            },
            "animations": {
                "hold_particle": "animation.bonus_item.hold_particle",
                "disappear_particle": "animation.bonus_item.disappear_particle",
                "trigger_command": "animation.bonus_item.trigger_command"
            },
            "scripts": {
                "animate": [
                    { "hold_particle": "query.property('aw:bonus_item_stage')==1" },
                    { "disappear_particle": "query.property('aw:bonus_item_stage')==2" },
                    { "trigger_command": "query.property('aw:bonus_item_stage')==2" }
                ]
            }
        },
        "components": {
            "minecraft:physics": {},
            "minecraft:damage_sensor": { "triggers": [ { "cause": "all", "deals_damage": false } ] },
            "minecraft:type_family": { "family": [ "bonus_item", "no_hook" ] }
        },
        "events": {
            "bonus_item_type:sword": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "sword", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:iron_pickaxe": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "iron_pickaxe", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:gray_glazed_terracotta": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "gray_glazed_terracotta", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:wind_pearl": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "wind_pearl", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:silver_glazed_terracotta": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "silver_glazed_terracotta", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:bow": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "bow", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:carved_pumpkin": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "carved_pumpkin", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:white_glazed_terracotta": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "white_glazed_terracotta", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:nautilus_shell": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "nautilus_shell", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:quiver": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "quiver", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:emerald_pickaxe": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "emerald_pickaxe", "aw:bonus_item_stage": 0 }
            },
            "bonus_item_type:water_gun": {
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_type": "water_gun", "aw:bonus_item_stage": 0 }
            },

            "bonus_item_stage:appear": {
                "remove": { "component_groups": [ "stage:disappear", "stage:hold" ] },
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_stage": 0, "aw:bonus_item_appear_style": 0 }
            },
            "bonus_item_stage:appear2": {
                "remove": { "component_groups": [ "stage:disappear", "stage:hold" ] },
                "add": { "component_groups": [ "stage:appear" ] },
                "set_property": { "aw:bonus_item_stage": 0, "aw:bonus_item_appear_style": 1 }
            },
            "bonus_item_stage:hold": {
                "remove": { "component_groups": [ "stage:appear", "stage:disappear" ] },
                "add": { "component_groups": [ "stage:hold" ] },
                "set_property": { "aw:bonus_item_stage": 1 }
            },
            "bonus_item_stage:disappear": {
                "remove": { "component_groups": [ "stage:hold" ] },
                "add": { "component_groups": [ "stage:disappear" ] },
                "set_property": { "aw:bonus_item_stage": 2 }
            },
            "bonus_item_stage:disappear_immediately": {
                "add": { "component_groups": [ "stage:disappear_immediately" ] },
                "set_property": { "aw:bonus_item_stage": 3 }
            }
        },
        "component_groups": {
            "stage:appear": {
                "minecraft:timer": { "time": 2, "time_down_event": { "event": "bonus_item_stage:hold", "target": "self" } }
            },
            "stage:hold": {
                "minecraft:entity_sensor": { "subsensors": [ { "range": [ 1, 1 ], "event_filters": { "test": "is_family", "subject": "other", "value": "player" }, "event": "bonus_item_stage:disappear" } ] }
            },
            "stage:disappear": {
                "minecraft:timer": { "time": 1, "time_down_event": { "event": "bonus_item_stage:disappear_immediately", "target": "self" } }
            },
            "stage:disappear_immediately": {
                "minecraft:instant_despawn": {}
            }
        }
    }
}