{
    "format_version": "1.20.10",
    "minecraft:entity": {
        "description": {
            "identifier": "aw:npc",
            "is_experimental": false,
            "is_spawnable": true,
            "is_summonable": true,
            "properties": {
                "aw:skin": { "type": "int", "range": [ 0, 1 ], "default": 0, "client_sync": true },
                "aw:geometry": { "type": "enum", "values": [ "default", "slim" ], "default": "default", "client_sync": true },
                
                "aw:state": { "type": "enum", "values": [ "stand", "sit", "lie", "sit_raising_head" ], "default": "stand", "client_sync": true },
                "aw:animation": { "type": "enum", "values": [  "none", "wave_hand", "speak", "applause", "place_block", "look_around", "nod", "shake_head", "bad_smile", "confuse", "point", "think"], "default": "none", "client_sync": true },
                "aw:speak_mode": { "type": "int", "range": [ 1, 4 ], "default": 1, "client_sync": true }
            },
            "scripts": { "animate": [ "interact_and_attack_test", "effects" ] },
            "animations": {
                "interact_and_attack_test": "controller.animation.npc.interact_and_attack_test",
                "effects": "animation.npc.effects"
            }
        },
        "components": {
            "minecraft:physics": { },
            "minecraft:collision_box": { "height": 1.8, "width": 0.6 },
            "minecraft:type_family": { "family": [ "npc", "no_hook" ] },
            "minecraft:knockback_resistance": { "value": 1 },
            "minecraft:persistent": { },
            "minecraft:health": { "value": 20, "max": 20 },
            "minecraft:nameable": { "allow_name_tag_renaming": true, "always_show": false },
            "minecraft:mark_variant": { "value": 0 },
            "minecraft:damage_sensor": { "triggers": [
                { "on_damage": { "event": "attacked", "target": "self" } }
            ] },
            "minecraft:interact": {
                "interactions": [
                    { "on_interact": { "event": "interacted", "target": "self" }, "interact_text": "action.interact.chat" }
                ]
            }

        },
        "events": {
            "interacted": { "remove": { "component_groups": [ "default_state" ] }, "add": { "component_groups": [ "interacted" ] } },
            "attacked": { "remove": { "component_groups": [ "default_state" ] }, "add": { "component_groups": [ "attacked" ] } },
            "interacted_reset": { "remove": { "component_groups": [ "interacted" ] }, "add": { "component_groups": [ "default_state" ] } },
            "attacked_reset": { "remove": { "component_groups": [ "attacked" ] }, "add": { "component_groups": [ "default_state" ] } },

            "minecraft:entity_spawned": {
                "randomize": [
                    { "add": { "component_groups": [ "should_see_player", "b0" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b1" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b2" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b3" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b4" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b5" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b6" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b7" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b8" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b9" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b10" ] }, "weight": 1 },
                    { "add": { "component_groups": [ "should_see_player", "b11" ] }, "weight": 1 }

                ]
            },
            "skin_0": { "add": { "component_groups": [ "should_see_player", "b0" ] } },
            "skin_1": { "add": { "component_groups": [ "should_see_player", "b1" ] } },
            "skin_2": { "add": { "component_groups": [ "should_see_player", "b2" ] } },
            "skin_3": { "add": { "component_groups": [ "should_see_player", "b3" ] } },
            "skin_4": { "add": { "component_groups": [ "should_see_player", "b4" ] } },
            "skin_5": { "add": { "component_groups": [ "should_see_player", "b5" ] } },
            "skin_6": { "add": { "component_groups": [ "should_see_player", "b6" ] } },
            "skin_7": { "add": { "component_groups": [ "should_see_player", "b7" ] } },
            "skin_8": { "add": { "component_groups": [ "should_see_player", "b8" ] } },
            "skin_9": { "add": { "component_groups": [ "should_see_player", "b9" ] } },
            "skin_10": { "add": { "component_groups": [ "should_see_player", "b10" ] } },
            "skin_11": { "add": { "component_groups": [ "should_see_player", "b11" ] } },
            "skin_12": { "add": { "component_groups": [ "should_see_player", "b12" ] } },
            "skin_13": { "add": { "component_groups": [ "should_see_player", "b13" ] } },
            "skin_14": { "add": { "component_groups": [ "should_see_player", "b14" ] } },
            "skin_15": { "add": { "component_groups": [ "should_see_player", "b15" ] } },
            "should_see_player": { "add": { "component_groups": [ "should_see_player" ] } },
            "should_not_see_player": { "remove": { "component_groups": [ "should_see_player" ] } },

            "aw:stand": { "set_property": { "aw:state": "stand" } },
            "aw:sit": { "set_property": { "aw:state": "sit" } },
            "aw:sit_raising_head": { "set_property": { "aw:state": "sit_raising_head" } },
            "aw:lie": { "set_property": { "aw:state": "lie" } },

            "aw:no_animation": { "set_property": { "aw:animation": "none" }, "remove": { "component_groups": [ "0.5_seconds", "1.5_seconds", "2_seconds", "4_seconds" ] } },
            "aw:wave_hand": { "set_property": { "aw:animation": "wave_hand" }, "add": { "component_groups": [ "1.5_seconds" ] } },
            "aw:speak": { "set_property": { "aw:animation": "speak", "aw:speak_mode": "math.random_integer(1, 4)" }, "add": { "component_groups": [ "2_seconds" ] } },
            "aw:applause": { "set_property": { "aw:animation": "applause" }, "add": { "component_groups": [ "2_seconds" ] } },
            "aw:place_block": { "set_property": { "aw:animation": "place_block" }, "add": { "component_groups": [ "1.5_seconds" ] } },
            "aw:look_around": { "set_property": { "aw:animation": "look_around" }, "add": { "component_groups": [ "2_seconds" ] } },
            "aw:nod": { "set_property": { "aw:animation": "nod" }, "add": { "component_groups": [ "0.5_seconds" ] } },
            "aw:shake_head": { "set_property": { "aw:animation": "shake_head" }, "add": { "component_groups": [ "0.5_seconds" ] } },
            "aw:bad_smile": { "set_property": { "aw:animation": "bad_smile" }, "add": { "component_groups": [ "2_seconds" ] } },
            "aw:confuse": { "set_property": { "aw:animation": "confuse" }, "add": { "component_groups": [ "2.75_seconds" ] } },
            "aw:point": { "set_property": { "aw:animation": "point" }, "add": { "component_groups": [ "2_seconds" ] } },
            "aw:think": { "set_property": { "aw:animation": "think" }, "add": { "component_groups": [ "2.75_seconds" ] } },

            "aw:remove_immediately": { "add": { "component_groups": [ "remove_immediately" ] } }
        },
        "component_groups": {
            "default_state": { "minecraft:mark_variant": { "value": 0 } },
            "interacted": { "minecraft:mark_variant": { "value": 1 } },
            "attacked": { "minecraft:mark_variant": { "value": 2 } },

            "b0": { "minecraft:variant": { "value": 0 } },
            "b1": { "minecraft:variant": { "value": 1 } },
            "b2": { "minecraft:variant": { "value": 2 } },
            "b3": { "minecraft:variant": { "value": 3 } },
            "b4": { "minecraft:variant": { "value": 4 } },
            "b5": { "minecraft:variant": { "value": 5 } },
            "b6": { "minecraft:variant": { "value": 6 } },
            "b7": { "minecraft:variant": { "value": 7 } },
            "b8": { "minecraft:variant": { "value": 8 } },
            "b9": { "minecraft:variant": { "value": 9 } },
            "b10": { "minecraft:variant": { "value": 10 } },
            "b11": { "minecraft:variant": { "value": 11 } },
            "b12": { "minecraft:variant": { "value": 12 } },
            "b13": { "minecraft:variant": { "value": 13 } },
            "b14": { "minecraft:variant": { "value": 14 } },
            "b15": { "minecraft:variant": { "value": 15 } },
            "should_see_player": { "minecraft:behavior.look_at_player": { "priority": 1 } },

            "remove_immediately": { "minecraft:instant_despawn": { } },

            "0.5_seconds": { "minecraft:timer": { "time": 0.5, "looping": false, "time_down_event": { "event": "aw:no_animation", "target": "self" } } },
            "1.5_seconds": { "minecraft:timer": { "time": 1.5, "looping": false, "time_down_event": { "event": "aw:no_animation", "target": "self" } } },
            "2_seconds": { "minecraft:timer": { "time": 2.0, "looping": false, "time_down_event": { "event": "aw:no_animation", "target": "self" } } },
            "2.75_seconds": { "minecraft:timer": { "time": 2.75, "looping": false, "time_down_event": { "event": "aw:no_animation", "target": "self" } } },
            "4_seconds": { "minecraft:timer": { "time": 4.0, "looping": false, "time_down_event": { "event": "aw:no_animation", "target": "self" } } }

        }
    }
}