{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:cave_spider",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "aw:spider_jockey": {
        "minecraft:addrider": {
          "entity_type": "minecraft:skeleton"
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": [
            "skeleton"
          ],
          "seats": {
            "position": [0.0, 0.3, -0.1]
          }
        }
      },
      "aw:spider_wither_jockey": {
        "minecraft:addrider": {
          "entity_type": "minecraft:wither_skeleton"
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": [
            "skeleton"
          ],
          "seats": {
            "position": [0.0, 0.25, -0.1]
          }
        }
      },
      "minecraft:spider_hostile": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": true,
          "reselect_targets": true,
          "within_radius": 25.0,
          "must_see_forget_duration": 17.0,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "test" :  "is_family", "subject" : "other", "value" :  "player"}
                ]
               },
               "max_dist": 32
             }
          ]
        },
        "minecraft:behavior.leap_at_target": {
          "priority": 4,
          "yd": 0.4,
          "must_be_on_ground": false
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "track_target": true,
          "random_stop_interval": 100,
          "reach_multiplier": 1.2
        }
      }
    },

    "components": {
      "minecraft:is_hidden_when_invisible": {
      },
      "minecraft:type_family": {
        "family": [ "cavespider", "monster", "arthropod", "mob" ]
      },
      "minecraft:breathable": {
        "total_supply": 0,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:nameable": {
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/zombie.json"
      },
      "minecraft:collision_box": {
        "width": 0.7,
        "height": 0.5
      },
      "minecraft:health": {
        "value": 15,
        "max": 15
      },
      "minecraft:attack": {
        "damage": 0,
        "effect_name": "poison",
        "effect_duration": 5
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:navigation.climb": {
        "can_path_over_water": true
      },
      "minecraft:movement.basic": {
      },
      "minecraft:jump.static": {
      },
      "minecraft:can_climb": {
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 1
      },
      "minecraft:behavior.mount_pathing": {
        "priority": 5,
        "speed_multiplier": 0.8,
        "target_dist": 0.0,
        "track_target": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": [
          "zombie"
        ],
        "seats": {
          "position": [ 0.0, 0.3, 0.0 ]
        }
      },
      "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {"component_groups":["minecraft:spider_hostile"]}
      },
      "aw:spider_jockey": {
        "add": {"component_groups":["minecraft:spider_hostile","aw:spider_jockey"]}
      },
      "aw:spider_wither_jockey": {
        "add": {"component_groups":["minecraft:spider_hostile","aw:spider_wither_jockey"]}
      }
    }
  }
}